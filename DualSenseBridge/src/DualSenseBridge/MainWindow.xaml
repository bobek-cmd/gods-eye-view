<Window x:Class="DualSenseBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DualSenseBridge.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DualSense Bridge"
        Width="980" Height="700" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Battery indicator: outline + fill scaled by the percentage. -->
        <DataTemplate x:Key="BatteryGlyph" DataType="{x:Type vm:ControllerViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="20" CornerRadius="4" BorderThickness="1.5" Padding="2"
                        BorderBrush="{StaticResource SubtleTextBrush}">
                    <Border x:Name="Fill" CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                            Background="{StaticResource SuccessBrush}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BatteryPercent, Converter={StaticResource PercentToFraction}}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Border Width="3" Height="8" CornerRadius="0,2,2,0" Background="{StaticResource SubtleTextBrush}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding BatteryLevel}" Value="Medium">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BatteryLevel}" Value="Low">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BatteryLevel}" Value="Charging">
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StickRing" TargetType="Ellipse">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Stroke" Value="{StaticResource BorderBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="{StaticResource SurfaceAltBrush}" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar with navigation -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,24,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DualSense Bridge" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="Kontroleri"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsToBool}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="Postavke" Margin="4,0,0,0"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsToBool}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="Driveri i pomoć" Margin="4,0,0,0"
                                 IsChecked="{Binding SelectedPage, Converter={StaticResource EqualsToBool}, ConverterParameter=2}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="Minimiziraj" Click="Minimize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Zatvori" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ============================== Controllers ============================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}">
                <StackPanel Margin="28,12,28,28">
                    <TextBlock Style="{StaticResource TitleText}" Text="Kontroleri" />
                    <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,18"
                               Text="DualSense se automatski prepoznaje preko Bluetootha (ili USB-a) i igrama se predstavlja kao Xbox 360 kontroler." />

                    <!-- Driver status strip -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViGEmReady}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="ViGEmBus: " Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="nije spreman" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViGEmReady}" Value="True">
                                                    <Setter Property="Text" Value="spreman" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HidHideActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Skrivanje originala (HidHide): " Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="neaktivno" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HidHideActive}" Value="True">
                                                    <Setter Property="Text" Value="aktivno" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- ViGEmBus missing -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                            Margin="0,0,0,16" Visibility="{Binding ViGEmReady, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Potreban je ViGEmBus driver" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="{Binding ViGEmText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Preuzmi ViGEmBus"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/nefarius/ViGEmBus/releases/latest" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Provjeri ponovno" Margin="8,0,0,0"
                                        Command="{Binding RefreshDriversCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HidHide missing -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                            Margin="0,0,0,16" Visibility="{Binding HidHideInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Preporučeno: instalirajte HidHide" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           Text="Bez HidHide-a neke igre vide i originalni DualSense i Xbox kontroler istovremeno (dvostruki unos)." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Preuzmi HidHide"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/nefarius/HidHide/releases/latest" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Provjeri ponovno" Margin="8,0,0,0"
                                        Command="{Binding RefreshDriversCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="32"
                            Visibility="{Binding HasControllers, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Čekam DualSense kontroler…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="13" TextAlignment="Center"
                                       Text="Uključite upareni kontroler pritiskom na tipku PS. Aplikacija će ga automatski prepoznati." />
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Prvo uparivanje" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,4" Text="1. Držite tipke Create i PS ~3 sekunde dok svjetlo ne počne brzo treptati." />
                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,4" Text="2. Windows Postavke → Bluetooth i uređaji → Dodaj uređaj → Bluetooth." />
                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Text="3. Odaberite „Wireless Controller“ – gotovo, ostalo radi automatski." />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Content="Otvori Bluetooth postavke" HorizontalAlignment="Center" Margin="0,16,0,0"
                                    Command="{Binding OpenBluetoothSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Controller cards -->
                    <ItemsControl ItemsSource="{Binding Controllers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                        </Border>

                                        <!-- Name, connection, status -->
                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                            <WrapPanel Margin="0,4,0,8">
                                                <TextBlock FontSize="13" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Text" Value="&#xECF0;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBluetooth}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE702;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource SubtleTextBrush}" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" />
                                                <TextBlock Text="{Binding PlayerText}" Foreground="{StaticResource SubtleTextBrush}" />
                                                <TextBlock Text="{Binding ReportRateText, StringFormat='  ·  {0}'}" Foreground="{StaticResource SubtleTextBrush}" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <Border x:Name="StatusPill" Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="StatusDotFill" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="320" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="HiddenPill" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" x:Name="HiddenIcon" Text="&#xE72E;" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="HiddenLabel" Text="Original skriven od igara" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Battery -->
                                        <StackPanel Grid.Column="2" Width="130" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BatteryGlyph}" />
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Margin="6,0,0,0" Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding BatteryText}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding ChargingText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>

                                        <!-- Live input preview -->
                                        <StackPanel Grid.Column="3" Margin="0,0,20,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="52" Height="52">
                                                    <Ellipse Style="{StaticResource StickRing}" />
                                                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentBrush}">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform X="{Binding LeftStickX}" Y="{Binding LeftStickY}" />
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <Grid Width="52" Height="52" Margin="10,0,0,0">
                                                    <Ellipse Style="{StaticResource StickRing}" />
                                                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentBrush}">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform X="{Binding RightStickX}" Y="{Binding RightStickY}" />
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                            </StackPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="5" CornerRadius="2.5" Background="{StaticResource BorderBrush}" ToolTip="L2">
                                                    <Border CornerRadius="2.5" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding L2}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                                <Border Grid.Column="2" Height="5" CornerRadius="2.5" Background="{StaticResource BorderBrush}" ToolTip="R2">
                                                    <Border CornerRadius="2.5" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding R2}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding PressedButtons}" Style="{StaticResource CaptionText}" Width="114" Height="16"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="128">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Test vibracije"
                                                    Command="{Binding DataContext.TestRumbleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Isključi kontroler" Margin="0,8,0,0"
                                                    ToolTip="Prekida Bluetooth vezu i gasi kontroler"
                                                    Command="{Binding DataContext.PowerOffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanPowerOff, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        <Setter TargetName="StatusDotFill" Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="False">
                                        <Setter TargetName="HiddenPill" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter TargetName="HiddenIcon" Property="Text" Value="&#xE7BA;" />
                                        <Setter TargetName="HiddenIcon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter TargetName="HiddenLabel" Property="Text" Value="Original vidljiv igrama" />
                                        <Setter TargetName="HiddenLabel" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== Settings ============================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}">
                <StackPanel Margin="28,12,28,28" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource TitleText}" Text="Postavke" Margin="0,0,0,18" />

                    <!-- General -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Općenito" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Pokreni s Windowsima" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Aplikacija se pokreće u pozadini pri prijavi, bez UAC upita (zadatak u Task Scheduleru)." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Pri automatskom pokretanju ostani u traci" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Prozor se ne otvara – aplikacija radi tiho uz ikonu pored sata." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Zatvaranje prozora skriva aplikaciju u traku" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Emulacija nastavlja raditi. Za potpuni izlaz koristite „Izlaz“ u izborniku ikone." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTrayOnClose}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Obavijesti" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Obavijest kad se kontroler spoji, odspoji ili mu je baterija pri kraju." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Upozorenje za slabu bateriju" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Razina baterije (%) na kojoj se prikazuje upozorenje. 0 = isključeno." />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="5" Value="{Binding LowBatteryWarning}" />
                                <TextBlock Grid.Column="2" Text="{Binding LowBatteryWarning, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Double input -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Sprječavanje dvostrukog unosa" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Sakrij originalni DualSense od igara (HidHide)" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Igre vide samo virtualni Xbox 360 kontroler. Original postaje ponovno vidljiv kad zatvorite aplikaciju." />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" Text="{Binding HidHideText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideOriginalController}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Rumble -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Vibracija" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Vibracija iz igara" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Prosljeđuje Xbox vibraciju na motore DualSense kontrolera." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RumbleEnabled}" />
                            </Grid>
                            <Grid IsEnabled="{Binding RumbleEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="Jačina vibracije" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding RumbleStrength}" />
                                <TextBlock Grid.Column="2" Text="{Binding RumbleStrength, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sticks and triggers -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Palice, okidači i tipke" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Mrtva zona lijeve palice" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Povećajte ako lik ili kamera „klize“ bez dodira palice." />
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding LeftStickDeadzone}" />
                                <TextBlock Grid.Column="2" Text="{Binding LeftStickDeadzone, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="Mrtva zona desne palice" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding RightStickDeadzone}" />
                                <TextBlock Grid.Column="2" Text="{Binding RightStickDeadzone, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="Mrtva zona okidača (L2/R2)" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{Binding TriggerDeadzone}" />
                                <TextBlock Grid.Column="2" Text="{Binding TriggerDeadzone, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Klik na touchpad" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Xbox tipka koju šalje pritisak na touchpad." />
                                </StackPanel>
                                <ListBox Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center"
                                         ItemsSource="{Binding TouchpadOptions}" SelectedValue="{Binding TouchpadClick}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lightbar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Svjetlosna traka" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Način rada" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="„Baterija“ prelazi iz zelene u crvenu kako se baterija prazni." />
                                </StackPanel>
                                <ListBox Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center"
                                         ItemsSource="{Binding LightbarOptions}" SelectedValue="{Binding LightbarMode}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="Vlastita boja" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ColorPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="24" Height="24" Margin="4,0,0,0" Cursor="Hand" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="0" />
                                                            <Ellipse Margin="3" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="Svjetlina" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding LightbarBrightness}" />
                                <TextBlock Grid.Column="2" Text="{Binding LightbarBrightness, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== Drivers & help ============================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}">
                <StackPanel Margin="28,12,28,28" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource TitleText}" Text="Driveri i pomoć" Margin="0,0,0,18" />

                    <!-- ViGEmBus -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViGEmReady}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="ViGEmBus" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="  obavezno" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="16,6,0,0"
                                           Text="Virtualni bus driver koji sustavu predstavlja pravi Xbox 360 kontroler. Koriste ga DS4Windows, Steam i mnogi drugi alati." />
                                <TextBlock Margin="16,8,0,0" Text="{Binding ViGEmText}" TextWrapping="Wrap" />
                                <TextBlock Margin="16,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding ViGEmVersion}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Preuzmi"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/nefarius/ViGEmBus/releases/latest" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HidHide -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HidHideActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="HidHide" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="  preporučeno" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="16,6,0,0"
                                           Text="Filter driver koji skriva originalni DualSense od igara, pa one vide samo Xbox kontroler – nema dvostrukog unosa ni pogrešnih ikona tipki." />
                                <TextBlock Margin="16,8,0,0" Text="{Binding HidHideText}" TextWrapping="Wrap" />
                                <TextBlock Margin="16,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding HidHideVersion}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Preuzmi"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/nefarius/HidHide/releases/latest" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Button Style="{StaticResource SecondaryButton}" Content="Provjeri drivere ponovno" Command="{Binding RefreshDriversCommand}" />
                    </StackPanel>

                    <!-- Help -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="Savjeti" />
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,8"
                                       Text="• Pokrenite DualSense Bridge prije igre. Igra koja je već otvorila originalni kontroler zadržava ga dok je ne ponovno pokrenete." />
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,8"
                                       Text="• Steam: u Postavke → Kontroler isključite „PlayStation Configuration Support“ za igre koje pokrećete preko ove aplikacije, inače Steam može dodati vlastiti virtualni kontroler." />
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,0,0,8"
                                       Text="• Ne pokrećite istovremeno DS4Windows, DualSenseX ili slične alate – i oni stvaraju virtualne kontrolere." />
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="12.5"
                                       Text="• Ako se kontroler ne pojavljuje: uklonite ga u Bluetooth postavkama i uparite ponovno (Create + PS)." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion, StringFormat='DualSense Bridge {0}'}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Koristi ViGEmBus i HidHide (Nefarius Software Solutions)." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Otvori logove" Command="{Binding OpenLogsCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Izlaz iz aplikacije" Margin="8,0,0,0" Command="{Binding ExitCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
